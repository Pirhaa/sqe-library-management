{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["title", "isbn", "author", "availableCopies"],
    "properties": {
      "title": {"type": "string"},
      "isbn": {"type": "string"},
      "author": {"type": "string"},
      "availableCopies": {"type": "integer", "minimum": 0}
    },
    "additionalProperties": false
  }
}